# GitLab 配置 — chmod 600，不进 git
# GITLAB_ROOT_PASSWORD：root 初始密码，仅首次启动时生效（之后改要用 rails console，务必先设好）
GITLAB_ROOT_PASSWORD=__CHANGE_ME__

# 数据目录：灰灰要求挂 /dockerData 数据盘
GITLAB_DATA_DIR=/dockerData/gitlab

# external_url 目前是内网直连 http://192.168.199.131:8080
# 以后接域名/HTTPS（宿主机 Nginx 反代）时改 compose 里 GITLAB_OMNIBUS_CONFIG 的 external_url

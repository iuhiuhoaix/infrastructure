# knotify(Company.Notify) 网关配置 — chmod 600，不进 git
# 全部键参考 knotify repo docs/CONFIG.md。
# 生产 fail-fast：ConnectTokenSecret / ProcessorSecret / AdminToken 为空或含 "change-me" 占位值时网关拒绝启动。

# 运行环境
ASPNETCORE_ENVIRONMENT=Production

# 数据库（试点：SQLite 单文件；生产可换 SqlServer / PostgreSQL，见 knotify repo deploy/README.md）
Notify__Provider=Sqlite
Notify__ConnectionString=Data Source=/data/notify.db
Notify__EnsureSchema=true

# Outbox 投递模式：Local = 网关内直推（单节点试点）；横向扩展改 Processor + 独立 Worker
Notify__Outbox__DispatchMode=Local
Notify__Outbox__ProcessorEnabled=true

# 客户端连接令牌 HMAC 签名密钥（必须强随机，fail-fast 校验）
Notify__Auth__ConnectTokenSecret=<openssl rand -hex 32>
# Worker 特权密钥（Local 模式暂不用，但 fail-fast 仍校验，先填上）
Notify__Auth__ProcessorSecret=<openssl rand -hex 32>
# 管理端点 /api/v1/admin/* 保护令牌（必须强随机）
Notify__AdminToken=<openssl rand -hex 32>

# 发布方初始凭证（仅首启种子，库中存 SHA256 哈希；发布时走 X-Api-Key 头）
Seed__PublisherAppId=devops
Seed__ApiKey=<openssl rand -hex 16>
Seed__HmacSecret=<openssl rand -hex 32>
Seed__AllowedSources=*
Seed__AllowedTopics=*

# 可选覆盖（默认值已在 compose.yaml 内置，一般无需改）
# KNOTIFY_SRC=/opt/knotify        # knotify 源码 clone 路径（build context）
# KNOTIFY_DATA_DIR=/dockerData/knotify   # 数据目录（默认 ./data）

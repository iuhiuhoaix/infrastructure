# Nexus 配置 — chmod 600，不进 git
# 首次启动初始 admin 密码在容器内 /nexus-data/admin.password，登录后改密
NEXUS_ADMIN_PASSWORD=__CHANGE_ME__
INSTALL4J_ADD_VM_PARAMS=-Xms1200m -Xmx1200m -XX:MaxDirectMemorySize=2g

# 可选覆盖（默认值已在 compose.yaml 内置，一般无需改）
# NEXUS_IMAGE=sonatype/nexus3:3.75.0        # 升级时显式指定新版本
# NEXUS_DATA_DIR=/opt/devops/nexus/data     # 数据目录（默认 ./data）

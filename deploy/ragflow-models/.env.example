# Start exactly one model profile. Keep RagFlow itself on its official `cpu` profile.
COMPOSE_PROFILES=models-cpu

# The official RagFlow compose must be started with project name `ragflow` for this default.
RAGFLOW_NETWORK_NAME=ragflow_ragflow

# Model cache survives container replacement. Create this directory before starting.
MODEL_CACHE_DIR=./models
# 国内镜像下载模型（hf-mirror.com）；离线环境改回官方地址并预下载到 MODEL_CACHE_DIR
HF_ENDPOINT=https://huggingface.co

# Loopback is safe for same-host deployment. For a remote GPU host, bind its private IP
# and restrict both ports to the RagFlow host at the firewall/security-group layer.
# NOTE: 本机 8080/8081 已被 GitLab/Nexus 占用，host 诊断端口用 6101/6102（容器间走 Docker alias 不受影响）
MODEL_BIND_ADDRESS=127.0.0.1
EMBEDDING_PORT=6101
RERANKER_PORT=6102
EMBEDDING_NETWORK_ALIAS=embedding-service
RERANKER_NETWORK_ALIAS=reranker-service

# Pin image and model revisions. Change them only through the versioning procedure in README.md.
TEI_CPU_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.8.3@sha256:8de25e75ce39617f17f2f6c77d60a4f75b65e779ed5005420eb1400072a15c1c
TEI_GPU_IMAGE=ghcr.io/huggingface/text-embeddings-inference:86-1.8.3@sha256:65f792e790f976713a5d2ab2586d93d074203d1f0ec2045e87e60113fbd0e256

EMBEDDING_MODEL_ID=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e

# CPU defaults target a small internal platform, not a developer laptop.
# NOTE: 本机扩容后 94G 内存/32 核，CPU 阶段按 8g 上限全并发（README 默认）
EMBEDDING_CPUS=8.0
EMBEDDING_MEMORY_LIMIT=8g
RERANKER_CPUS=8.0
RERANKER_MEMORY_LIMIT=8g
EMBEDDING_MAX_CONCURRENT_REQUESTS=64
EMBEDDING_MAX_BATCH_TOKENS=16384
RERANKER_MAX_CONCURRENT_REQUESTS=32
RERANKER_MAX_BATCH_TOKENS=8192

# The first GPU phase shares GPU 0. Set the reranker to 1 only after adding a second GPU.
EMBEDDING_GPU_DEVICE_ID=0
RERANKER_GPU_DEVICE_ID=0
EMBEDDING_GPU_MEMORY_LIMIT=16g
RERANKER_GPU_MEMORY_LIMIT=16g

MODEL_LOG_MAX_SIZE=100m
MODEL_LOG_MAX_FILES=5

# 模型下载走 mihomo 代理（huggingface.co 支持 content-range；hf-mirror 不返回该头，TEI 1.8.3 不兼容）
HTTP_PROXY=http://172.17.0.1:7897
HTTPS_PROXY=http://172.17.0.1:7897

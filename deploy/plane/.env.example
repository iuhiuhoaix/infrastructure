# Plane 配置 — chmod 600，不进 git
PGPASSWORD=__CHANGE_ME__

# MinIO / 对象存储
AWS_ACCESS_KEY_ID=__CHANGE_ME__
AWS_SECRET_ACCESS_KEY=__CHANGE_ME__
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_BUCKET_NAME=plane
AWS_REGION=us-east-1

# Plane 应用
NEXT_PUBLIC_API_BASE_URL=https://plane.example.com
CORS_ALLOWED_ORIGINS=https://plane.example.com
NGINX_PORT=80
WEB_URL=https://plane.example.com
SECRET_KEY=__CHANGE_ME__

# 数据库
DATABASE_URL=postgresql://plane:${PGPASSWORD}@postgres:5432/plane
REDIS_URL=redis://redis:6379/

# 与 GitLab 集成（可选）
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=

# Plane 配置 — chmod 600，不进 git
PGPASSWORD=__CHANGE_ME__

# 数据目录：灰灰要求挂 /dockerData 数据盘（与 GitLab 对齐）
PLANE_DATA_DIR=/dockerData/plane

# MinIO / 对象存储
AWS_ACCESS_KEY_ID=__CHANGE_ME__
AWS_SECRET_ACCESS_KEY=__CHANGE_ME__
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_BUCKET_NAME=plane
AWS_REGION=us-east-1

# RabbitMQ（Celery broker，Redis 仅作缓存）
RABBITMQ_HOST=mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=__CHANGE_ME__
RABBITMQ_VHOST=plane

# Plane 应用（内网直连，对齐 GitLab；接域名/HTTPS 时改成 https://plane.example.com）
WEB_URL=http://192.168.199.131:3000
# 新版 Plane(1.4+) 前端拆分 base URL，缺了 onboarding「Get Started」会跳回，必须设
APP_BASE_URL=http://192.168.199.131:3000
ADMIN_BASE_URL=http://192.168.199.131:3000
SPACE_BASE_URL=http://192.168.199.131:3000
LIVE_BASE_URL=http://192.168.199.131:3000
CORS_ALLOWED_ORIGINS=http://192.168.199.131:3000
NGINX_PORT=80
# gunicorn worker 数，不设会 `-w ''` 崩溃循环
GUNICORN_WORKERS=2
SECRET_KEY=__CHANGE_ME__

# 数据库（⚠️ env_file 不做变量展开，密码须写明文，与上方 PGPASSWORD 一致）
DATABASE_URL=postgresql://plane:__CHANGE_ME__@postgres:5432/plane
REDIS_URL=redis://redis:6379/

# 与 GitLab 集成（可选）
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=

# RagFlow 配置 — chmod 600，不进 git（⚠️ 灰灰自行维护，本模板供参考）
MYSQL_PASSWORD=__CHANGE_ME__
MINIO_USER=__CHANGE_ME__
MINIO_PASSWORD=__CHANGE_ME__

# 镜像 / 版本（官方默认 v0.26.4，可覆盖）
RAGFLOW_IMAGE=infiniflow/ragflow:v0.26.4
STACK_VERSION=8.11.3

# 服务端口（容器内 nginx 对外 80，宿主 127.0.0.1:9380 映射）
SVR_HTTP_PORT=9380
TZ=Asia/Shanghai

# 内置 TEI embedding（官方 compose-base 的 tei profile）
# 二选一：BAAI/bge-m3 或 Qwen/Qwen3-Embedding-0.6B（灰灰正在评估）
# TEI_MODEL=BAAI/bge-m3
# TEI_PORT=6380
# 已有本机服务备选：http://infinity-bge-m3:7997（需把该容器挂 devops-internal）

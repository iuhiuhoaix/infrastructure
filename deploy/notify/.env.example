# ntfy 配置 — chmod 600，不进 git
# 鉴权：token + deny-all（私有 topic，不裸奔）。首次部署后创建用户/token：
#   docker exec ntfy ntfy user add --role=admin admin <强密码>
#   docker exec ntfy ntfy token add admin ops     # 输出 token 即 API 凭据（Bearer 头）
# 详细步骤见本目录 README.md

# 认证数据库（/data 是容器内挂载点）
NTFY_AUTH_FILE=/data/auth.db
# 默认拒绝一切未认证访问；只有持 token 的用户能 pub/sub 自己的 topic
NTFY_AUTH_DEFAULT_ACCESS=deny-all
# 消息缓存保留时长：离线设备上线可补收最近消息；超期即丢（转发即丢，不承担存储职责）
NTFY_CACHE_DURATION=24h
# Web UI / 链接里显示的对外地址
NTFY_BASE_URL=http://192.168.199.131:8084

# 可选覆盖（默认值已在 compose.yaml 内置，一般无需改）
# NTFY_DATA_DIR=/dockerData/ntfy     # 数据目录（默认 ./data）
# NTFY_IMAGE=binwiederhier/ntfy:v2.26.3   # 升级时显式指定新版本
